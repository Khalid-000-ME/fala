# local | testnet | mainnet. Leave VITE_VAULT_ADDRESS empty to browse the dashboard with demo data.
VITE_NETWORK=testnet
VITE_VAULT_ADDRESS=
VITE_VAULT_DEPLOY_BLOCK=0
# optional: shows Approve/Deny mailto buttons on pending requests (the Worker's inbound address)
# VITE_INBOUND_ADDRESS=approve@your-domain.example
# optional overrides
# VITE_TESTNET_RPC=https://rpc.testnet.arc.io
