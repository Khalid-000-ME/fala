NETWORK=testnet                      # local | testnet | mainnet
RPC_URL=https://rpc.testnet.arc.io   # mainnet: https://rpc.mainnet.arc.io
VAULT_ADDRESS=0x...
VAULT_DEPLOY_BLOCK=0
OWNER_PRIVATE_KEY=0x...              # configures the vault, deposits, unfreezes
AGENT_PRIVATE_KEY=0x...              # the agent EOA (small gas float)
RELAYER_PRIVATE_KEY=0x...            # submits approveByEmail; may earn a small tip (small gas float)
APPROVER_EMAIL=you@gmail.com         # the dedicated Gmail that approves
VENDOR_A=0x...                       # wallets you control, so USDC comes back
VENDOR_B=0x...
GROQ_API_KEY=
MODEL=openai/gpt-oss-120b
NOTIFY_URL=                          # your deployed Worker, e.g. https://fala-approver.<you>.workers.dev
NOTIFY_TOKEN=                        # shared secret, same value as the Worker's NOTIFY_TOKEN secret
MAX_FEE_GWEI=25                      # Arc's mempool floor is 20 gwei
PRIORITY_FEE_GWEI=1
