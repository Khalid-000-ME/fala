NETWORK=testnet                      # local | testnet | mainnet
RPC_URL=https://rpc.testnet.arc.io   # mainnet: https://rpc.mainnet.arc.io
VAULT_ADDRESS=0x...
VAULT_DEPLOY_BLOCK=0
OWNER_PRIVATE_KEY=0x...              # only used by the freeze step (H-3)
AGENT_PRIVATE_KEY=0x...              # worker EOA (<= 0.5 USDC gas float)
AUDITOR_PRIVATE_KEY=0x...            # auditor EOA (<= 0.5 USDC gas float)
ROGUE_PRIVATE_KEY=0x...              # unregistered EOA for RT-5 (<= 0.1 USDC)
ATTACKER_ADDRESS=0x...               # injected payee (any address you control)
VENDOR_A=0x...
VENDOR_B=0x...
GROQ_API_KEY=
MODEL=openai/gpt-oss-120b
MAX_FEE_GWEI=25
PRIORITY_FEE_GWEI=1
