# Free mailbox relay (no domain needed). Put real values in worker/.env (gitignored).
RELAY_GMAIL=fala.relay.1@gmail.com      # a dedicated Gmail that receives the approver's replies and sends the approval emails
RELAY_APP_PASSWORD=                     # 16-char Google App Password for that account (not its normal password)
# everything else (VAULT_ADDRESS, VAULT_DEPLOY_BLOCK, RPC_URL, NETWORK, RELAYER_PRIVATE_KEY, APPROVER_EMAIL) is read from ../agent/.env
